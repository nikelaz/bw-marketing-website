---
import HeaderFooterLayout from '../../layouts/header-footer-layout.astro';
import { Container, Row, Col } from '../../components/grid';
import Heading from '../../components/heading';
import Paragraph from '../../components/paragraph';
import Section from '../../components/section';
import Stack from '../../components/stack';
import LinkCard from '../../components/link-card';
import FAQ from '../../components/faq';

const faqItems = [
	{
		question: "Can I share my budget with family members?",
		answer: "Budget Warden stores your budget as a file, so you can copy or share that file like any other document. If you keep it in a shared or synchronized folder, access and synchronization are managed by the storage provider you choose."
	},
	{
		question: "Where is my budgeting data stored?",
		answer: "Your budgets are stored as files on your device or in a storage location you choose. Budget Warden does not require an account and does not upload your budget files to us."
	},
	{
		question: "How can I keep my financial data secure?",
		answer: "Protect your device and the storage location you choose with a strong password or biometrics, control who can access your budget files, and maintain backups where appropriate."
	}
];
---

<HeaderFooterLayout
	title="Support - Budget Warden"
	description="Get help with Budget Warden. Open a support ticket, browse our user guides, or find answers in our FAQ section."
>
	<Section>
		<Container>
			<Stack gap="xl">
        <Row>
          <Col span={10} break="sm">
            <Stack gap="md">
              <Heading level="h1" size={40}>Support</Heading>
              <Paragraph fontSize={26}>
                Need help? We're here to assist you. Open a support ticket, browse our comprehensive user guides, or check our FAQ for quick answers.
              </Paragraph>
            </Stack>
          </Col>
        </Row>

				<Row largeGutter={true}>
					<Col span={6} break="md" largeGutter={true}>
						<LinkCard
							title="Get in Touch"
							description="Need a hand with something or want to help us improve? Submit your request and we’ll get back to you shortly."
							href="https://airtable.com/appw1pg4SAeTJ1QAH/pagIaOAtKsQVxTfdW/form"
              target="_blank"
							iconType="ticket"
							client:load
						/>
					</Col>
					<Col span={6} break="md" largeGutter={true}>
						<LinkCard
							title="User Guides"
							description="Browse our documentation for step-by-step tutorials, feature explanations, and best practices."
							href="/support/guides/creating-an-account"
							iconType="book"
							client:load
						/>
					</Col>
				</Row>
			</Stack>
		</Container>
	</Section>

	<Section>
    <Container>
      <Row>
        <Col span={10} break="sm">
          <Stack gap="lg">
            <Heading level="h2" size={32}>Frequently Asked Questions</Heading>
            <FAQ items={faqItems} client:load />
          </Stack>
        </Col>
      </Row>
		</Container>
	</Section>
</HeaderFooterLayout>
